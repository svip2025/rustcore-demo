[Unit]
Description=rustcore-demo caller and read-only HTTP
# Requires/PartOf/BindsTo would propagate a scenario's core restart to the caller.
Wants=rustcore.service network-online.target
After=rustcore.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=rustcore-demo
Group=rustcore-demo
WorkingDirectory=/opt/rustcore-demo/current
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/rustcore-demo/tools/node-v22.23.2-linux-x64/bin/node --import tsx scripts/start-caller.ts --env /etc/rustcore-demo/env
Restart=always
RestartSec=3
TimeoutStopSec=180
UMask=0077
# The one exact sudo command needs setuid. Do not add RestrictSUIDSGID or a
# capability bounding set that removes sudo's setuid/setgid capabilities here.
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/var/lib/rustcore-demo
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
