[Unit]
Description=48-hour rustcore testnet observation attempt %i
Wants=caller.service
After=caller.service

[Service]
Type=simple
User=rustcore-demo
Group=rustcore-demo
WorkingDirectory=/opt/rustcore-demo/current
ExecStart=/usr/bin/python3 /opt/rustcore-demo/current/deploy/observe-48h.py run --output /var/lib/rustcore-demo/observations/%i --freeze-file /etc/systemd/system/rustcore.service --freeze-file /etc/systemd/system/caller.service --freeze-file /etc/systemd/system/scenario.service --freeze-file /etc/systemd/system/scenario.timer --freeze-file /etc/systemd/system/rustcore-observe@.service --freeze-file /etc/systemd/system/rustcore-health.service --freeze-file /etc/systemd/system/rustcore-health.timer --freeze-file /etc/caddy/Caddyfile --freeze-file /etc/caddy/sites-enabled/rustcore-demo.caddy --freeze-file /opt/rustcore-demo/bin/f8a331a/rustcore --freeze-file /opt/rustcore-demo/tools/node-v22.23.2-linux-x64/bin/node --freeze-file /opt/rustcore-demo/rustcore-web-production-20261103-014852.tgz --freeze-file /srv/rustcore-demo-web/current/BUILD-INFO.json
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rustcore-demo/observations
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
