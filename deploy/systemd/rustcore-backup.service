[Unit]
Description=Online SQLite backups, retaining seven complete generations

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/rustcore-demo/current/deploy/backup.py
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/rustcore-demo
ReadOnlyPaths=/var/lib/rustcore-demo
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
