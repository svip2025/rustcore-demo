[Unit]
Description=Dispatch one due 2A slot, without catch-up or overlap
Wants=caller.service
After=caller.service

[Service]
Type=oneshot
User=rustcore-demo
Group=rustcore-demo
WorkingDirectory=/opt/rustcore-demo/current
ExecStart=/opt/rustcore-demo/tools/node-v22.23.2-linux-x64/bin/node --import tsx scripts/run-round2.ts --action tick --state /var/lib/rustcore-demo/round2-schedule.db --env /etc/rustcore-demo/env
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rustcore-demo
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
