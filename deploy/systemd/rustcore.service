[Unit]
Description=rustcore testnet kernel
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=rustcore-demo
Group=rustcore-demo
WorkingDirectory=/opt/rustcore-demo/current
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/rustcore-demo/tools/node-v22.23.2-linux-x64/bin/node --import tsx scripts/start-systemd-kernel.ts --env /etc/rustcore-demo/env
Restart=always
RestartSec=3
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/rustcore-demo
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
