[Unit]
Description=One scheduled testnet scenario, with the caller's existing lock
Wants=caller.service
After=caller.service

[Service]
Type=oneshot
User=rustcore-demo
Group=rustcore-demo
WorkingDirectory=/opt/rustcore-demo/current
ExecStart=/opt/rustcore-demo/tools/node-v22.23.2-linux-x64/bin/node --import tsx scripts/run-scenario.ts --env /etc/rustcore-demo/env --trigger SCHEDULED
# A failed round is retained. No restart/retry and no additional flock layer.
TimeoutStartSec=1h
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rustcore-demo
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
