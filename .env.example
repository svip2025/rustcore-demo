# Public template only. Both secret fields below are deliberately empty.
# Copy to a private ordinary file owned by the service user, then chmod 600.
# Default private file: /etc/rustcore-demo/env; local CLI may use --env.
# Literal KEY=VALUE or double-quoted text only; no shell expansion or execution.
# Never commit the completed private file or print its contents.

ENGINE_LIVE_ENABLED=0
ENGINE_STAGE_MAX=demo
DEMO_CREDENTIAL_ID=9001
BINANCE_VENUE_H39303031=testnet
BINANCE_API_KEY_H39303031=""
# Supply the secret separately in the private file.
BINANCE_API_SECRET_H39303031=""
# For the other isolated test account, use ID 9002 and suffix H39303032 instead.
# These local IDs are not exchange UIDs. Use distinct exchange accounts and keys.

# Replace these example absolute paths with dedicated, writable local paths.
RUSTCORE_GRPC_ADDR=127.0.0.1:50051
RUSTCORE_DB_URL=sqlite:///var/lib/rustcore-demo/rustcore.db
DEMO_CALLER_DB_FILE=/var/lib/rustcore-demo/caller.db
DEMO_LOCK_FILE=/var/lib/rustcore-demo/scenario.lock
DEMO_KERNEL_BINARY=/opt/rustcore-demo/rustcore/target/release/rustcore
DEMO_HOLD_MS=180000
DEMO_PHASE_TIMEOUT_MS=120000

# Read-only HTTP. A reverse proxy can expose this during the later deployment step.
DEMO_HTTP_ADDR=127.0.0.1:8787
# Exact site origin for browser CORS; leave unset for curl/local same-origin use.
# DEMO_PUBLIC_ORIGIN=https://demo.example.com
# Enable only behind a loopback proxy that overwrites X-Real-IP.
DEMO_TRUST_PROXY=0

# REST request WEIGHTS, not requests/second. Testnet reported 6000/min on 2026-11-02.
# 20/s is 1200/min; the engine keeps its own reserve, cooldown and budget guards.
RUSTCORE_BINANCE_TESTNET_WEIGHT_PER_SEC=20
RUSTCORE_BINANCE_TESTNET_WEIGHT_BURST=100

# Fill actual output of git rev-parse HEAD after the caller's initial commit.
# unknown means an uncommitted draft, never an accepted build fingerprint.
DEMO_CALLER_COMMIT=unknown
# Actual pinned submodule baseline. Update only with an explicitly accepted pin.
DEMO_RUSTCORE_COMMIT=f8a331a1a3ff035162ceca657b2467dc45583a61

# No URL override is needed: the authorized endpoint compatibility update uses
# https://demo-fapi.binance.com and wss://demo-fstream.binance.com for Testnet.
